LLM_BASE_URL=http://localhost:18989/v1
LLM_API_KEYS=ollama
LLM_MODEL=gemma-3-12b-it

# Ollama alias gemma-3-12b-it should point to Gemma 3 12B (gemma3:12b).
# LLM_MAX_NEW_TOKENS=1200

## Experiment 1:
# LLM_MODEL=gemma-3-12b-it
# IMAGE_LAWDB_DETECTION_MODEL=GroundingDINO
# IMAGE_QUERY_DETECTION_MODEL=GroundingDINO
# EMBEDDING_NAME=siglip2-so400m-patch14-384


# # Experiment 2:
# LLM_MODEL=gemma-3-12b-it
# IMAGE_LAWDB_DETECTION_MODEL=GroundingDINO
# IMAGE_QUERY_DETECTION_MODEL=YoloE
# EMBEDDING_NAME=siglip2-so400m-patch14-384

# # Experiment 3:
# LLM_MODEL=gemma-3-12b-it
# IMAGE_LAWDB_DETECTION_MODEL=ImageProcessing
# IMAGE_QUERY_DETECTION_MODEL=YoloE
# EMBEDDING_NAME=siglip2-so400m-patch14-384

# Experiment 4:
LLM_MODEL=gemma-3-12b-it
IMAGE_LAWDB_DETECTION_MODEL=ImageProcessing
IMAGE_QUERY_DETECTION_MODEL=Yolo26s
EMBEDDING_NAME=CLIP-GmP-ViT-L-14
LIMIT=5
SIGN_MODEL_PATH=models/yolo26s_vtsdb100_best.pt
SIGN_DETECTION_CONFIDENCE_THRESHOLD=0.25
# The fine-tuned YOLO26s detector supplies sign identities directly.
ENABLE_SIGN_RETRIEVAL_FALLBACK=false
SIGN_RECOGNITION_CANDIDATE_LIMIT=10
TRAFFIC_SIGN_OCR_ENABLED=true
TRAFFIC_SIGN_OCR_DEVICE=gpu
TRAFFIC_SIGN_OCR_LANGUAGE=vi
